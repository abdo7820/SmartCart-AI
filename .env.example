# Catalog database (read-only data): SQLite file, or set DATABASE_URL for PostgreSQL
DATABASE_PATH=data/db/ecommerce.db
# DATABASE_URL=postgresql://user:password@host:5432/smartcart

# Application database (accounts, sessions, chat, audit): SQLite file, or APP_DATABASE_URL for PostgreSQL
APP_DATABASE_PATH=data/db/app.db
# APP_DATABASE_URL=postgresql://user:password@host:5432/smartcart

# Browser origins allowed to call the API with cookies
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Session cookie. In production serve over HTTPS and set COOKIE_SECURE=true
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
SESSION_TTL_HOURS=168

# Rate limits (in memory, per process)
RATE_LIMIT_ENABLED=true
LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_S=300
REGISTER_MAX_PER_HOUR=10
CHAT_MAX_PER_MINUTE=20

# Chat assistant language model. The backend calls the provider; never expose this key to the frontend.
# For Groq's OpenAI-compatible API, set these values in your uncommitted .env after rotating/provisioning a key:
# LLM_PROVIDER=openai
# LLM_API_KEY=your-new-groq-key
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_BASE_URL=https://api.groq.com/openai/v1
# Leave LLM_PROVIDER=none for the built-in deterministic catalog assistant.
LLM_PROVIDER=none

# First administrator: used only by scripts/create_admin.py. Do not commit real values.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
